        {"tool_name": "vehicle_resolution_tool", "arguments": {"make": "D", "model": "x"}},
        {"tool_name": "vehicle_resolution_tool", "arguments": {"make": "E", "model": "x"}},
        {"tool_name": "vehicle_resolution_tool", "arguments": {"make": "F", "model": "x"}}
