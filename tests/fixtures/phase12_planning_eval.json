  "cases": [
    {
      "id": "P12-01_graphrag_alone_is_enough",
      "category": "sufficient_evidence",
      "question": "What do owners report about brakes on the Ford F-150 2020?",
      "citation_table": [
        {"citation_id": "c1", "source_type": "complaint", "label": "Complaint 11420001 - Ford F-150"}
