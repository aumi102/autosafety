      "note": "An empty plan is a correct answer, not a failure. Mandatory GraphRAG already ran."
    },
    {
      "id": "P12-02_structured_count_query",
      "category": "valid_plan",
      "question": "How many complaints per component for the Ford F-150 2020?",
      "plan": [
        {
          "tool_name": "sql_analytics_tool",
          "operation": "complaint_count_by_component_for_vehicle",
          "arguments": {"make": "Ford"}
        }
      ],
      "expect": {"accepted_tools": ["sql_analytics_tool"]},
      "note": "The model names a predefined operation. It never supplies SQL."
    },
    {
      "id": "P12-03_graph_relationship_query",
      "category": "valid_plan",
      "question": "Which recalls are related to the brake complaints on this vehicle?",
      "plan": [
        {
          "tool_name": "graph_evidence_tool",
          "operation": "recall_paths_by_vehicle",
          "arguments": {"vehicle_id": "0a0a0a0a-0b0b-4c0c-8d0d-0e0e0e0e0e0e"}
        }
      ],
      "expect": {"accepted_tools": ["graph_evidence_tool"]}
    },
    {
      "id": "P12-04_ambiguous_vehicle_reference",
      "category": "valid_plan",
      "question": "Are there recalls for the F-150?",
      "plan": [
        {
          "tool_name": "vehicle_resolution_tool",
          "arguments": {"make": "Ford", "model": "F-150"}
