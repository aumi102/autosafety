# Application
APP_ENV=development
LOG_LEVEL=INFO
AUTH_ENABLED=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autosafety
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/autosafety

# Redis (for future Celery jobs)
REDIS_URL=redis://localhost:6379/0

# Neo4j (for future graph work)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
