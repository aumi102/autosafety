# Application
APP_ENV=development
LOG_LEVEL=INFO
AUTH_ENABLED=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autosafety
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/autosafety

# Redis (for future Celery jobs)
REDIS_URL=redis://localhost:6379/0

# Neo4j (for future graph work)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# GraphRAG (Phase 6)
GRAPHRAG_EMBEDDING_PROVIDER=deterministic  # deterministic | sentence_transformers
GRAPHRAG_EMBEDDING_MODEL=deterministic-test-v1
GRAPHRAG_EMBEDDING_DIMENSION=384

# Phase 7C — Answer Synthesis Provider
# Provider: deterministic (tests/offline/fallback) | fake | openai_compatible (requires ALLOW_EXTERNAL=true + credentials)
PHASE7_SYNTHESIS_PROVIDER=deterministic
PHASE7_SYNTHESIS_MODEL=
PHASE7_SYNTHESIS_ALLOW_EXTERNAL=false
PHASE7_PROVIDER_TIMEOUT_SECONDS=30
PHASE7_MAX_TOOL_ROUNDS=2
PHASE7_MAX_TOOL_CALLS=4
PHASE7_MAX_EVIDENCE_ITEMS=20
PHASE7_MAX_EVIDENCE_CHARS=16000
PHASE7_MAX_OUTPUT_CHARS=8000
PHASE7_MAX_CLAIMS=8

# OpenAI-compatible provider (set only when PHASE7_SYNTHESIS_ALLOW_EXTERNAL=true)
# PHASE7_PROVIDER_API_KEY=sk-...
# PHASE7_PROVIDER_BASE_URL=https://api.openai.com/v1
# Supports OpenAI-compatible chat-completions endpoints matching the implemented
# protocol: POST {base_url}/chat/completions, "Authorization: Bearer <key>" header,
# JSON body {model, messages, temperature, max_tokens}. Verified against OpenAI.
# Self-hosted servers exposing the identical request shape (e.g. vLLM, LM Studio,
# Ollama's /v1 endpoint, OpenRouter) are potentially compatible but NOT verified.
# Azure OpenAI is NOT compatible as-is (different URL/api-version/auth header).
